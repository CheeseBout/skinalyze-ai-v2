# Copy this file to .env and fill in the values.
# On Hugging Face Spaces, set these as Secrets instead of committing a .env file.

# --- Required ---
# OpenAI API key. Used for both the RAG chatbot (gpt-4o-mini) and startup self-test.
OPENAI_API_KEY=

# --- Optional (defaults shown) ---
# Chat model used by the RAG chain.
OPENAI_MODEL=gpt-4o-mini

# Sentence-transformers embedding model used to build/query the product vector store.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hugging Face token (read-only) — avoids the "unauthenticated requests" rate
# limit warning when downloading EMBEDDING_MODEL on first run. Get one at
# https://huggingface.co/settings/tokens. Not required, just recommended.
HF_TOKEN=

# LLM generation settings.
LLM_TEMPERATURE=0.05
LLM_MAX_TOKENS=1500
LLM_MAX_RETRIES=3
LLM_TIMEOUT=90

# Fixed USD -> VND conversion rate used when displaying product prices.
USD_TO_VND=26349

# Comma-separated list of allowed CORS origins. "*" allows any origin (default).
# Example: CORS_ORIGINS=https://your-nestjs-backend.com,https://your-frontend.com
CORS_ORIGINS=*
